{
  "schemaVersion": "2.0",
  "meta": {
    "title": "Affix Tree — default question bank",
    "author": "",
    "updated": "2026-09-06",
    "howToEdit": {
      "affix": [
        "root is the word shown on the trunk; target is the finished word.",
        "requires is \"prefix\", \"suffix\" or \"both\" — it decides which sides of the tree are live.",
        "validPrefix + root + validSuffix must spell target exactly. Use null for a side that isn't needed.",
        "Any number of options per side up to layouts.split.fan.maxOptionsPerSide — the branches are generated to fit."
      ],
      "synonyms/antonyms": [
        "word is the word being matched, shown inside the question.",
        "answer is the single correct option and must appear in options.",
        "Any number of options up to layouts.canopy.fan.maxOptions — the canopy packs them into rows and grows to fit.",
        "Good distractors are near-misses. The trunk stays blank; the pick appears on the plaque."
      ]
    }
  },
