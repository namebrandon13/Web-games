{
  "schemaVersion": "2.0",
  "game": {
    "id": "affix-tree",
    "title": "Affix Tree",
    "questionsFile": "questions.json",
    "note": "questionsFile may be a single filename or an array of filenames. All files are merged by mode."
  },
  "modes": [
    {
      "id": "affix",
      "label": "Prefix & Suffix",
      "tagline": "Build the word",
      "tree": "split",
      "answer": "affix",
      "clueLabel": "Meaning",
      "clueTemplate": "{definition}",
      "subField": null,
      "trunkShows": "root"
    },
    {
      "id": "synonyms",
      "label": "Synonyms",
      "tagline": "Pick the matching word",
      "tree": "canopy",
      "answer": "single",
      "clueLabel": "Same meaning",
      "clueTemplate": "Which word means the same as “{word}”?",
      "subField": "definition",
      "trunkShows": "blank"
    },
    {
      "id": "antonyms",
      "label": "Antonyms",
      "tagline": "Pick the opposite",
      "tree": "canopy",
      "answer": "single",
      "clueLabel": "Opposite meaning",
      "clueTemplate": "Which word means the opposite of “{word}”?",
      "subField": "definition",
      "trunkShows": "blank"
    }
  ],
  "rules": {
    "maxAttemptsPerQuestion": 3,
    "revealAnswerWhenAttemptsRunOut": true,
    "shuffleQuestions": false,
    "shuffleOptions": false,
    "questionsPerRound": 0
  },
  "scoring": {
    "correctFirstTry": 100,
    "correctAfterRetry": 60,
    "wrongAttemptPenalty": 0,
    "unsolved": 0
  },
  "feedback": {
    "needChoice": "Pick a word from the tree to continue.",
    "needPrefix": "Choose a prefix from the left before checking.",
    "needSuffix": "Choose a suffix from the right before checking.",
    "needBoth": "This word needs both a prefix and a suffix.",
    "correctAffix": "Perfect — {target}.",
    "correctSingle": "Correct — {answer}.",
    "incorrect": "Not quite. Try again.",
    "incorrectAffix": "That doesn't build a real word. Try another piece.",
    "lastAttempt": "One attempt left — read the meaning again carefully.",
    "outOfAttemptsAffix": "Out of attempts. The word was {target}.",
    "outOfAttemptsSingle": "Out of attempts. The answer was {answer}.",
    "roundComplete": "Round complete."
  },
  "results": {
    "collectStudentName": true,
    "autoSaveLocalStorage": true,
    "storageKey": "affix-tree-results",
    "downloadFileName": "results.json",
    "endpoint": ""
  },
  "theme": {
    "paper": "#FDFAF4",
    "page": "#F6F1E7",
    "ink": "#2A2620",
